[Unit]
Description=Autoscript VL - Multi-Login IP Limiter & Quota Daemon
Documentation=https://github.com/risqinf/vl
After=network.target xray.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/vl limit daemon
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
