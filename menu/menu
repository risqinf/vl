#!/usr/bin/env bash
# ==============================================================================
# Autoscript VL - Interactive TUI Dashboard
# Architecture: High-Performance VLESS WebSocket Stack
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

check_status() {
    local s="$1"
    if systemctl is-active --quiet "$s" 2>/dev/null; then
        echo -e "${GREEN}RUNNING${NC}"
    else
        echo -e "${RED}STOPPED${NC}"
    fi
}

get_ip() {
    curl -s --connect-timeout 2 ifconfig.me 2>/dev/null || curl -s --connect-timeout 2 icanhazip.com 2>/dev/null || echo "127.0.0.1"
}

get_domain() {
    if [ -f /etc/vl/domain ]; then
        head -n 1 /etc/vl/domain | tr -d ' \r\n'
    elif [ -f /etc/shvl/domain ]; then
        head -n 1 /etc/shvl/domain | tr -d ' \r\n'
    elif [ -f /etc/xray/domain ]; then
        head -n 1 /etc/xray/domain | tr -d ' \r\n'
    else
        get_ip
    fi
}

get_traffic() {
    local iface
    iface=$(ip -4 route show default 2>/dev/null | awk '{print $5}' | head -n 1)
    [ -z "$iface" ] && iface="eth0"

    local vn_bin="/usr/bin/vnstat"
    [ ! -x "$vn_bin" ] && vn_bin="/usr/local/bin/vnstat"
    [ ! -x "$vn_bin" ] && vn_bin="vnstat"

    ttoday=$("$vn_bin" -i "$iface" 2>/dev/null | grep "today" | awk '{print $8" "$9}')
    [ -z "$ttoday" ] && ttoday=$("$vn_bin" -d 2>/dev/null | grep -E "today|$(date +'%Y-%m-%d')" | head -n 1 | awk '{print $8" "$9}')
    [ -z "$ttoday" ] && ttoday="0.00 B"

    tyest=$("$vn_bin" -i "$iface" 2>/dev/null | grep "yesterday" | awk '{print $8" "$9}')
    [ -z "$tyest" ] && tyest=$("$vn_bin" -d 2>/dev/null | grep -E "yesterday|$(date -d 'yesterday' +'%Y-%m-%d' 2>/dev/null)" | head -n 1 | awk '{print $8" "$9}')
    [ -z "$tyest" ] && tyest="0.00 B"

    cur_mon=$(date +"%Y-%m" 2>/dev/null)
    tmon=$("$vn_bin" -i "$iface" -m 2>/dev/null | grep "$cur_mon" | awk '{print $8" "$9}')
    [ -z "$tmon" ] && tmon=$("$vn_bin" -m 2>/dev/null | grep "$cur_mon" | awk '{print $8" "$9}')
    [ -z "$tmon" ] && tmon=$("$vn_bin" -i "$iface" -m 2>/dev/null | grep -E '^[[:space:]]*[0-9]{4}-[0-9]{2}' | head -n 1 | awk '{print $8" "$9}')
    [ -z "$tmon" ] && tmon="0.00 B"
}

show_menu() {
    clear
    local DOMAIN=$(get_domain)
    local IP=$(get_ip)
    local OS_NAME=$(grep -oP '(?<=PRETTY_NAME=).+' /etc/os-release 2>/dev/null | tr -d '"' || echo "Ubuntu / Debian")
    local RAM_USED=$(free -m 2>/dev/null | awk '/Mem:/ {print $3}')
    local RAM_TOTAL=$(free -m 2>/dev/null | awk '/Mem:/ {print $2}')
    local UPTIME=$(uptime -p 2>/dev/null | sed 's/up //')

    get_traffic

    local ST_XR=$(check_status xray)
    local ST_HA=$(check_status haproxy)
    local ST_LM=$(check_status vl-limiter)
    [ "$ST_LM" = "${RED}STOPPED${NC}" ] && ST_LM=$(check_status shvl-limiter)

    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e " ${BOLD}${PURPLE}            AUTOSCRIPT VL - VLESS WS DASHBOARD                  ${NC}"
    echo -e " ${CYAN}          Optimized for Ubuntu 24.04 LTS & Debian 13            ${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${WHITE}OS Server${NC}   : ${GREEN}$OS_NAME${NC}"
    echo -e "  ${WHITE}IP Address${NC}  : ${GREEN}$IP${NC}"
    echo -e "  ${WHITE}Host / Domain${NC}: ${GREEN}$DOMAIN${NC}"
    echo -e "  ${WHITE}RAM Usage${NC}   : ${GREEN}${RAM_USED:-0} MB / ${RAM_TOTAL:-0} MB${NC}"
    echo -e "  ${WHITE}Uptime${NC}      : ${GREEN}${UPTIME:-Running}${NC}"
    echo -e "${CYAN}────────────────────────────────────────────────────────────────${NC}"
    echo -e "  ${WHITE}TRAFIK HARI INI :${NC} ${GREEN}$ttoday${NC}"
    echo -e "  ${WHITE}TRAFIK KEMARIN  :${NC} ${YELLOW}$tyest${NC}"
    echo -e "  ${WHITE}TOTAL BULAN INI :${NC} ${CYAN}$tmon${NC}"
    echo -e "${CYAN}────────────────────────────────────────────────────────────────${NC}"
    echo -e "  ${WHITE}Xray VLESS${NC}  : $ST_XR       |  ${WHITE}HAProxy Mux${NC}   : $ST_HA"
    echo -e "  ${WHITE}IP Limiter${NC}  : $ST_LM (Cooldown 5 Menit Auto-Unlock)"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e " ${BOLD}${YELLOW}[ MANAJEMEN AKUN VLESS WS ]${NC}"
    echo -e "  ${GREEN}[1]${NC}  Buat Akun VLESS Baru            ${CYAN}[add-vless]${NC}"
    echo -e "  ${GREEN}[2]${NC}  Buat Akun Trial VLESS (1 Hari)  ${CYAN}[trial-vless]${NC}"
    echo -e "  ${GREEN}[3]${NC}  Perpanjang Masa Aktif VLESS     ${CYAN}[renew-vless]${NC}"
    echo -e "  ${GREEN}[4]${NC}  Hapus Akun VLESS                ${CYAN}[del-vless]${NC}"
    echo -e "  ${GREEN}[5]${NC}  Daftar Semua Akun VLESS         ${CYAN}[list-vless]${NC}"
    echo -e "  ${GREEN}[6]${NC}  Cetak Ulang Link VLESS          ${CYAN}[slip-vless]${NC}"
    echo -e "  ${GREEN}[7]${NC}  Cek User & Koneksi Aktif VLESS  ${CYAN}[cek-vless]${NC}"
    echo ""
    echo -e " ${BOLD}${YELLOW}[ OPERASIONAL & KEAMANAN ]${NC}"
    echo -e "  ${GREEN}[8]${NC}  Recovery Akun Expired           ${CYAN}[recovery]${NC}"
    echo -e "  ${GREEN}[9]${NC}  Reset Kuota Penggunaan Data     ${CYAN}[reset-quota]${NC}"
    echo -e "  ${GREEN}[10]${NC} Ban / Kunci Akun Pengguna       ${CYAN}[ban]${NC}"
    echo -e "  ${GREEN}[11]${NC} Unban / Buka Kunci Akun         ${CYAN}[unban]${NC}"
    echo -e "  ${GREEN}[12]${NC} Cek Status IP Limiter           ${CYAN}[ceklim]${NC}"
    echo -e "  ${GREEN}[13]${NC} Bersihkan Akun Expired (XP)     ${CYAN}[xp]${NC}"
    echo ""
    echo -e " ${BOLD}${YELLOW}[ SISTEM & PENGATURAN ]${NC}"
    echo -e "  ${GREEN}[14]${NC} Detail Bandwidth (vnstat)       ${CYAN}[bandwidth]${NC}"
    echo -e "  ${GREEN}[15]${NC} Ganti Domain & Terbitkan SSL    ${CYAN}[domain]${NC}"
    echo -e "  ${GREEN}[16]${NC} Perbarui Sertifikat SSL         ${CYAN}[renew-cert]${NC}"
    echo -e "  ${GREEN}[17]${NC} Backup Sistem ke Telegram       ${CYAN}[backup]${NC}"
    echo -e "  ${GREEN}[18]${NC} Restore Sistem dari Backup      ${CYAN}[restore]${NC}"
    echo -e "  ${GREEN}[19]${NC} Konfigurasi Bot Telegram        ${CYAN}[telegram]${NC}"
    echo -e "  ${GREEN}[20]${NC} Restart Semua Service           ${CYAN}[restart]${NC}"
    echo -e "  ${GREEN}[21]${NC} Update Autoscript VL            ${CYAN}[update]${NC}"
    echo -e "  ${GREEN}[22]${NC} Reboot VPS"
    echo -e "  ${GREEN}[0]${NC}  Keluar"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -ne " ${BOLD}Pilih opsi [0-22]: ${NC}"
    read -r opt

    case "$opt" in
        1|add|add-vless)
            /usr/local/bin/vl add-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        2|trial|trial-vless)
            /usr/local/bin/vl trial-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        3|renew|renew-vless)
            /usr/local/bin/vl renew-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        4|del|del-vless|delete)
            /usr/local/bin/vl del-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        5|list|list-vless)
            /usr/local/bin/vl list-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        6|slip|slip-vless|detail)
            /usr/local/bin/vl slip-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        7|cek|cek-vless)
            /usr/local/bin/cek-vless
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        8|recovery|rec)
            /usr/local/bin/vl recovery
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        9|reset-quota|reset)
            /usr/local/bin/vl reset-quota
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        10|ban|lock)
            /usr/local/bin/vl ban
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        11|unban|unlock)
            /usr/local/bin/vl unban
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        12|limit|ceklim|autokill)
            /usr/local/bin/vl limit
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        13|xp|expired)
            /usr/local/bin/vl xp
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        14|vnstat|bandwidth|bw)
            if [ -x /usr/local/bin/bandwidth ]; then
                /usr/local/bin/bandwidth
            elif [ -x /usr/bin/bandwidth ]; then
                /usr/bin/bandwidth
            fi
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        15|domain)
            /usr/local/bin/vl domain
            ;;
        16|cert|renew-cert)
            /usr/local/bin/renew-cert
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        17|backup)
            /usr/local/bin/vl backup
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        18|restore)
            /usr/local/bin/vl restore
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        19|telegram|bot)
            /usr/local/bin/vl telegram
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        20|restart)
            /usr/local/bin/restart
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        21|update)
            echo -e "${CYAN}[INFO] Mengunduh dan memperbarui Autoscript VL ke commit terbaru...${NC}"
            bash <(curl -fsSL https://raw.githubusercontent.com/risqinf/vl/main/install.sh)
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        22|reboot)
            echo -ne "Yakin ingin reboot VPS? (y/n): "
            read -r ans
            if [[ "$ans" =~ ^[Yy]$ ]]; then
                reboot
            fi
            ;;
        0|x|X|q|exit)
            clear
            exit 0
            ;;
        *)
            echo -e "${RED}Pilihan tidak valid!${NC}"
            sleep 1
            ;;
    esac
}

while true; do
    show_menu
done
