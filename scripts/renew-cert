#!/usr/bin/env bash
# ==============================================================================
# Autoscript VL - SSL Certificate Renew & Installation Utility
# Target: Ubuntu 24.04 & Debian 13
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

clear 2>/dev/null || true
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "       ${GREEN}[*] AUTOSCRIPT VL - SSL CERTIFICATE MANAGER [*]${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

DOMAIN=""
if [ -f /etc/vl/domain ]; then
    DOMAIN=$(tr -d ' \r\n' < /etc/vl/domain)
elif [ -f /etc/shvl/domain ]; then
    DOMAIN=$(tr -d ' \r\n' < /etc/shvl/domain)
elif [ -f /etc/xray/domain ]; then
    DOMAIN=$(tr -d ' \r\n' < /etc/xray/domain)
fi

if [ -z "$DOMAIN" ]; then
    echo -e "${RED}[ERROR] File domain tidak ditemukan!${NC}"
    read -r -p "Masukkan domain VPS Anda: " input_domain
    DOMAIN=$(echo "$input_domain" | tr -d ' \r\n')
    if [ -z "$DOMAIN" ]; then
        echo -e "${RED}[ABORT] Domain kosong. Batalkan.${NC}"
        exit 1
    fi
    mkdir -p /etc/vl /etc/shvl /etc/xray
    echo "$DOMAIN" > /etc/vl/domain
    echo "$DOMAIN" > /etc/shvl/domain
    echo "$DOMAIN" > /etc/xray/domain
fi

echo -e "Domain Terdeteksi: ${YELLOW}$DOMAIN${NC}\n"

mkdir -p /etc/vl/ssl /etc/shvl/ssl /etc/ssl/private /etc/xray
chmod 700 /etc/ssl/private 2>/dev/null || true

if [ ! -f /root/.acme.sh/acme.sh ]; then
    echo -e "${YELLOW}[INFO] Mengunduh acme.sh...${NC}"
    curl -s https://get.acme.sh | sh
fi

echo -e "${YELLOW}[1/4] Menghentikan service & membebaskan port 80 dari bentrok...${NC}"
systemctl stop haproxy nginx apache2 caddy lighttpd 2>/dev/null || true
systemctl disable apache2 nginx 2>/dev/null || true

if command -v fuser >/dev/null 2>&1; then
    fuser -k -9 80/tcp 2>/dev/null || true
fi

pkill -9 -f haproxy 2>/dev/null || true

if command -v ss >/dev/null 2>&1; then
    pids_80=$(ss -tulpn 'sport = :80' 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u)
    for p in $pids_80; do
        [ -n "$p" ] && kill -9 "$p" 2>/dev/null || true
    done
fi
if command -v lsof >/dev/null 2>&1; then
    for p in $(lsof -ti:80 2>/dev/null || true); do
        [ -n "$p" ] && kill -9 "$p" 2>/dev/null || true
    done
fi

sleep 1

if command -v ss >/dev/null 2>&1 && ss -tulpn 'sport = :80' 2>/dev/null | grep -q LISTEN; then
    echo -e "${RED}[WARNING] Port 80 masih terpakai oleh proses:${NC}"
    ss -tulpn 'sport = :80' 2>/dev/null || true
else
    echo -e "${GREEN}[OK] Port 80 berhasil dibebaskan (siap untuk ACME standalone).${NC}"
fi

echo -e "\n${YELLOW}[2/4] Menerbitkan / memperbarui sertifikat SSL via acme.sh...${NC}"
/root/.acme.sh/acme.sh --set-default-ca --server letsencrypt --debug || true
/root/.acme.sh/acme.sh --register-account -m "admin@${DOMAIN}" --server letsencrypt --debug 2>/dev/null || true

if ! /root/.acme.sh/acme.sh --issue -d "$DOMAIN" --standalone --keylength ec-256 --force; then
    echo -e "\n${YELLOW}[INFO] Mencoba mode renew...${NC}"
    /root/.acme.sh/acme.sh --renew -d "$DOMAIN" --ecc --force || true
fi

echo -e "\n${YELLOW}[3/4] Memasang sertifikat ke direktori sistem...${NC}"
/root/.acme.sh/acme.sh --install-cert -d "$DOMAIN" --ecc \
    --fullchain-file /etc/vl/ssl/fullchain.pem \
    --key-file /etc/vl/ssl/privkey.pem || true

if [ ! -s /etc/vl/ssl/fullchain.pem ] || [ ! -s /etc/vl/ssl/privkey.pem ]; then
    if [ -s "/root/.acme.sh/${DOMAIN}_ecc/fullchain.cer" ]; then
        cp -f "/root/.acme.sh/${DOMAIN}_ecc/fullchain.cer" /etc/vl/ssl/fullchain.pem
        cp -f "/root/.acme.sh/${DOMAIN}_ecc/${DOMAIN}.key" /etc/vl/ssl/privkey.pem
    elif [ -s "/root/.acme.sh/${DOMAIN}/fullchain.cer" ]; then
        cp -f "/root/.acme.sh/${DOMAIN}/fullchain.cer" /etc/vl/ssl/fullchain.pem
        cp -f "/root/.acme.sh/${DOMAIN}/${DOMAIN}.key" /etc/vl/ssl/privkey.pem
    fi
fi

if [ ! -s /etc/vl/ssl/fullchain.pem ] || [ ! -s /etc/vl/ssl/privkey.pem ]; then
    echo -e "${RED}[WARNING] File sertifikat belum siap, membuat SSL self-signed fallback...${NC}"
    openssl req -new -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -days 365 -nodes -x509 \
        -subj "/CN=$DOMAIN" -keyout /etc/vl/ssl/privkey.pem -out /etc/vl/ssl/fullchain.pem >/dev/null 2>&1
fi

cat /etc/vl/ssl/fullchain.pem /etc/vl/ssl/privkey.pem > /etc/vl/vl.pem
chmod 600 /etc/vl/vl.pem /etc/vl/ssl/privkey.pem
chmod 644 /etc/vl/ssl/fullchain.pem

mkdir -p /etc/shvl/ssl
cp -f /etc/vl/vl.pem /etc/shvl/shvl.pem 2>/dev/null || true
cp -f /etc/vl/ssl/fullchain.pem /etc/shvl/ssl/fullchain.pem 2>/dev/null || true
cp -f /etc/vl/ssl/privkey.pem /etc/shvl/ssl/privkey.pem 2>/dev/null || true

cp -f /etc/vl/ssl/fullchain.pem /etc/ssl/private/fullchain.pem 2>/dev/null || true
cp -f /etc/vl/ssl/privkey.pem /etc/ssl/private/privkey.pem 2>/dev/null || true
chmod 600 /etc/ssl/private/privkey.pem 2>/dev/null || true
chmod 644 /etc/ssl/private/fullchain.pem 2>/dev/null || true

cp -f /etc/vl/ssl/fullchain.pem /etc/xray/xray.crt 2>/dev/null || true
cp -f /etc/vl/ssl/privkey.pem /etc/xray/xray.key 2>/dev/null || true
cp -f /etc/vl/ssl/fullchain.pem /etc/xray/certinfo.crt 2>/dev/null || true
cp -f /etc/vl/ssl/privkey.pem /etc/xray/certinfo.key 2>/dev/null || true
echo "$DOMAIN" > /etc/xray/domain
chmod 600 /etc/xray/xray.key /etc/xray/certinfo.key 2>/dev/null || true
chmod 644 /etc/xray/xray.crt /etc/xray/certinfo.crt 2>/dev/null || true

echo -e "${YELLOW}[4/4] Menjalankan kembali layanan (HAProxy & Xray)...${NC}"
systemctl restart haproxy 2>/dev/null || true
systemctl restart xray 2>/dev/null || true

echo -e "\n${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "   ${GREEN}[OK] Sertifikat SSL Berhasil Diperbarui & Disinkronkan${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e " Lokasi File:"
echo -e "   * VL SSL       : /etc/vl/ssl/fullchain.pem"
echo -e "   * HAProxy PEM  : /etc/vl/vl.pem"
echo -e "   * Xray Cert    : /etc/xray/xray.crt"
echo -e "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e " Status Sertifikat:"
openssl x509 -in /etc/vl/ssl/fullchain.pem -noout -issuer -dates 2>/dev/null | sed 's/^/   /'
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
